# Copy to .env.local. Every key is optional in development: a missing provider makes its
# flow show "not configured" instead of crashing. Never commit .env.local.

# Public URL of this deployment. Used for hand-off links back to the platform.
NEXT_PUBLIC_LAB_URL=https://lab.openidea.world

# --- Open Idea platform (pre-existing; not part of the hackathon submission) ---
# Public API key from https://openidea.world/developer
OPENIDEA_API_URL=https://openidea.world/api/v1
OPENIDEA_API_KEY=
# Knowledge graph (Resource -MENTIONS-> TECH/ORG/PERSON). Defaults to {OPENIDEA_API_URL}/graph.
OPENIDEA_GRAPH_URL=

# --- Meta Model API: Muse Spark (https://dev.meta.ai/docs) ---
# REQUIRED for the Lab Agent product path (Muse-only tool loop).
# Obtain the key from Cursor / Claude Code Muse configuration
# ("Configure Claude Code" or Cursor-configured Muse API keys) and paste it here.
# Do not invent keys. Lab reads META_API_KEY via lib/env.ts → lib/muse.ts / lib/muse-agent.ts.
META_API_KEY=
META_API_URL=https://api.meta.ai/v1
META_MODEL=muse-spark-1.3

# --- Lab product packaging (Free teaser vs Lab Pro ≤ $20) ---
# LAB_PLAN=free|pro  (default free). Lab Pro list price must stay ≤ 20.
LAB_PLAN=free
LAB_PRO_PRICE_USD=20
LAB_AGENT_MAX_TURNS=15

# --- Fireworks: OPTIONAL legacy one-shot flow only (NOT used by Muse agent loop) ---
# Agent reasoning is Muse-only. Leave unset for the paid product path.
FIREWORKS_API_KEY=
FIREWORKS_CODE_MODEL=accounts/fireworks/models/deepseek-v4p1-flash
FIREWORKS_RANK_MODEL=accounts/fireworks/models/nemotron-lightning-3p5-30b-a3b
FIREWORKS_VISION_MODEL=accounts/fireworks/models/deepseek-v4p1-flash

# --- Baseten: OPTIONAL SAM 3 vision GPU (secondary; not LLM reasoning) ---
BASETEN_API_KEY=
BASETEN_SAM3_MODEL_ID=         # from the Baseten dashboard after `truss push baseten/sam3`

# --- Optional: prices, so the usage panel can show cost ---
# Leave empty to show tokens and GPU time only. Copy the current rates from each
# provider's pricing page; they change, so they are not hard-coded.
META_PRICE_IN_PER_M=           # USD per 1M input tokens
META_PRICE_OUT_PER_M=          # USD per 1M output tokens
FIREWORKS_PRICE_IN_PER_M=
FIREWORKS_PRICE_OUT_PER_M=
BASETEN_PRICE_PER_MIN=         # USD per minute of the GPU your SAM 3 deployment runs on

# --- Credit budget (dashboard at /usage, and a pause before the credit runs out) ---
# The credit you were given, in USD. Leave a provider empty for no cap on it.
META_CREDIT_USD=
FIREWORKS_CREDIT_USD=
BASETEN_CREDIT_USD=
# New runs pause when a provider reaches this % of its credit (default 90).
LAB_BUDGET_STOP_PCT=90
# Required in production to open /usage?key=<this value>. Make it long and random.
LAB_ADMIN_KEY=
# Shared counters. Without these the count is per server instance and resets on deploy,
# so the pause is only reliable with them set (free Upstash Redis database is enough).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Access (recommended on any public deployment) ---
# Shared passcode judges and friends enter once; empty means the site is open.
LAB_PASSCODE=
# API calls allowed per visitor per hour (a build is about 5). Default 40.
LAB_RATE_LIMIT_PER_HOUR=40
